# Reference only: npm start reads the process environment, not this file.
# Configure values in the launching shell or operator-managed environment.
# The backend binds to 127.0.0.1; default port is 3001.
PORT=3001
# Required for protected routes; set a matching disposable local value on Vite.
# No credential is supplied by this example. Never use a production secret here.
BACKEND_SECRET=
# Enable only with verified trusted ingress controlling forwarded identity.
TRUST_TOOLBOX_PROXY_HEADERS=false
# See ../docs/CONFIGURATION.md and ../README.md for setup.
