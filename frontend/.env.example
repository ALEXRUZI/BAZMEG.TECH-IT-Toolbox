# Vite server-side development settings; never use VITE_* for a backend secret.
# Default when unset: local backend. Browser API calls remain relative /api URLs.
BACKEND_ORIGIN=http://127.0.0.1:3001
# Set the same disposable secret in the backend shell and here (or in the
# frontend shell environment). Empty disables API access with HTTP 503.
BACKEND_SECRET=
# HTTP requires a loopback IP literal (127.0.0.0/8 or [::1]); hostnames require HTTPS.
# Optional deliberate remote backend: set BACKEND_ORIGIN to its HTTPS origin
# and BACKEND_SECRET to its matching credential. HTTPS verification stays enabled.
# Non-loopback API clients are blocked, even with dev:lan, unless explicitly enabled.
# Enable only on a trusted network: all allowed clients then use this server's secret.
ALLOW_LAN_API_PROXY=false
# Development only; production Pages bindings are configured separately.
# See ../docs/CONFIGURATION.md. Restart Vite after changing settings.
