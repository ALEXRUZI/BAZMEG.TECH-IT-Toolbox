{
  "name": "bazmeg-tech-it-toolbox",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "preview:lan": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.test.json",
    "check:ssh-bundle": "node scripts/check-ssh-forge-bundle.mjs",
    "typecheck:pages": "tsc --project functions/tsconfig.json",
    "test:pages": "vitest run tests/pages-proxy.test.mjs",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@noble/ciphers": "2.4.0",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "bcrypt-pbkdf": "1.0.2",
    "fflate": "0.8.3",
    "hash-wasm": "4.12.0",
    "html-to-image": "^1.11.13",
    "micro-rsa-dsa-dh": "0.4.0",
    "node-forge": "1.4.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261010.1",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "asn1js": "^3.0.10",
    "jsdom": "^30.1.2",
    "tailwindcss": "^4.3.0",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "^5.0.3"
  }
}
